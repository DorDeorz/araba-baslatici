<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android Auto'nun ana birim sunucusuna (127.0.0.1:5277) bağlanmak için. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android Auto sesli komutları için mikrofon. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Bir kez adb ile verilir; kendi erişilebilirlik servisimizi gerektiğinde yeniden açmak için. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Bildirimdeki "Stop" yazısını Android Auto'nun dilinde okumak için. -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:label="Araba Başlatıcı"
        android:icon="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BaslatActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".BtAlici"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".OturumIzleyici"
            android:exported="true"
            android:label="Araba Başlatıcı"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".SunucuBaslatici"
            android:exported="false"
            android:label="Araba Başlatıcı – sunucuyu başlat"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sunucu_baslatici" />
        </service>

        <activity
            android:name=".ekran.EkranActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <activity
            android:name=".AyarlarActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".IptalAlici"
            android:exported="false" />
    </application>
</manifest>
